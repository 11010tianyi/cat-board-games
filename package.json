{
  "name": "cat-board-games",
  "version": "1.0.0",
  "private": true,
  "description": "SVG board game collection themed around black and white Chinese domestic cats.",
  "homepage": "https://11010tianyi.github.io/cat-board-games/",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:mobile": "tsc && vite build --base ./",
    "mobile:sync": "bun run build:mobile && cap sync",
    "android:sync": "bun run build:mobile && cap sync android",
    "android:apk": "bun run android:sync && cd android && ./gradlew assembleDebug",
    "ios:sync": "bun run build:mobile && cap sync ios",
    "ios:open": "bun run ios:sync && cap open ios",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --import ./scripts/test-preload.mjs --test scripts/playable.test.ts scripts/music.test.ts scripts/sfx.test.ts scripts/immersive.test.ts"
  },
  "keywords": [
    "bun",
    "typescript",
    "svg",
    "board-game",
    "cat"
  ],
  "author": "11010tianyi",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1"
  }
}
